{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-Pasev/CodexStation.Omega.Public/schemas/publication_candidate.schema.json",
  "title": "CodexStation Omega Public Publication Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "source_lineage",
    "artifact_paths",
    "claim_classes",
    "authority_ceiling",
    "provenance",
    "gate_state"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "DEFINITION",
          "DERIVED_LAW",
          "FORMAL_THEOREM",
          "THEOREM_TARGET",
          "FINITE_MACHINE_EVIDENCE",
          "EMPIRICAL_EVIDENCE",
          "ENGINEERING_PROPOSAL",
          "EXTERNAL_PUBLIC_ANCHOR"
        ]
      }
    },
    "authority_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_state": {
      "type": "object",
      "required": [
        "secret_pii",
        "license_ip",
        "claim_evidence",
        "authority",
        "provenance",
        "dedup",
        "witness"
      ]
    },
    "authority_delta": {
      "enum": [
        "NONE",
        "SCOPED_EXPLICIT"
      ]
    }
  },
  "additionalProperties": true
}
