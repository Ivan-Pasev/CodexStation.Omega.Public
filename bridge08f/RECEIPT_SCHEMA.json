{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilc.invalid/schemas/codexstation-omega-private-reproduction-receipt-0.8f.json",
  "title": "CodexStation Omega Private Reproduction Receipt 0.8f",
  "type": "object",
  "required": [
    "schema",
    "source_family",
    "repository",
    "source_commit",
    "runner_identity",
    "commands",
    "results",
    "overall_status",
    "sanitized",
    "private_source_disclosed",
    "authority_delta"
  ],
  "properties": {
    "schema": {
      "const": "GILC/CODEXSTATION/OMEGA-PRIVATE-REPRODUCTION-RECEIPT/0.8f"
    },
    "source_family": {
      "enum": [
        "DIGITAL_FABRICA_CORE",
        "HIGHESTONE",
        "NEURAL_LATTICE"
      ]
    },
    "repository": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runner_identity": {
      "type": "object",
      "required": [
        "provider",
        "run_id",
        "runner_commit"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "runner_commit": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD"
      ]
    },
    "scope": {
      "type": "string"
    },
    "sanitized": {
      "const": true
    },
    "private_source_disclosed": {
      "const": false
    },
    "source_tree_modified_for_test": {
      "const": false
    },
    "authority_delta": {
      "const": "NONE"
    }
  },
  "additionalProperties": true
}
